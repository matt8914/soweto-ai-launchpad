{
  "name": "soweto-ai-launchpad",
  "version": "0.1.0",
  "private": false,
  "description": "A one-day Codex starter repo for the Boundless Soweto AI App Development Challenge 2026.",
  "scripts": {
    "dev": "next dev",
    "db:reset": "tsx scripts/db-reset.ts",
    "seed": "tsx scripts/db-reset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test",
    "build": "next build",
    "smoke": "node scripts/smoke.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.3",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
